{
  "tasks": {
    "dev": "deno run --allow-read --allow-net --allow-env --watch server.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "cookie-parser": "npm:cookie-parser@^1.4.7",
    "debug": "npm:debug@^4.4.1",
    "express": "npm:express@^4.17.3",
    "helmet": "npm:helmet@^8.1.0",
    "http-errors": "npm:http-errors@^2.0.0",
    "morgan": "npm:morgan@^1.10.0"
  },
  "lint": {
    "tags": [
      "recommended"
    ],
    "include": [
      "camelcase",
      "eqeqeq",
      "explicit-function-return-type",
      "no-await-in-loop",
      "no-const-assign",
      "no-external-import",
      "no-inferrable-types",
      "no-non-null-asserted-optional-chain",
      "no-non-null-assertion",
      "no-self-compare",
      "no-sparse-arrays",
      "no-sync-fn-in-async-fn",
      "no-throw-literal",
      "no-undef",
      "no-useless-rename",
      "single-var-declarator"
    ]
  },
  "fmt": {
    "singleQuote": true,
    "trailingCommas": "never"
  }
}