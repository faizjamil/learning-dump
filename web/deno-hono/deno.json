{
  "tasks": {
    "dev": "deno run --watch main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "hono": "npm:hono@^4.7.5"
  },
  "lint": {
    "tags": [
      "recommended"
    ],
    "include": [
      "camelcase",
      "eqeqeq",
      "explicit-function-return-type",
      "no-await-in-loop",
      "no-const-assign",
      "no-external-import",
      "no-inferrable-types",
      "no-non-null-asserted-optional-chain",
      "no-non-null-assertion",
      "no-self-compare",
      "no-sparse-arrays",
      "no-sync-fn-in-async-fn",
      "no-throw-literal",
      "no-undef",
      "no-useless-rename",
      "single-var-declarator"
    ]
  },
  "fmt": {
    "singleQuote": true,
    "trailingCommas": "never"
  }
}